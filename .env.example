# Wspólny sekret autoryzacyjny dla integracji Karty <-> MTGSpot Scraper (minimum 8 znaków).
# MUSI być identyczny z wartością KARTY_SYNC_TOKEN w serwisie mtgspot-scraper.
# Nigdy nie używaj tutaj hasła administratora (admin_password).
MTGSPOT_SYNC_TOKEN=change-me-to-a-long-random-integration-secret

# Opcjonalnie: adres URL serwisu mtgspot-scraper (umożliwia wywołanie natychmiastowej synchronizacji z panelu /admin)
# MTGSPOT_SCRAPER_API_URL=http://localhost:8000
